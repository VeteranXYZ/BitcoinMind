# Long-cache fingerprinted assets (JS, CSS, fonts, images Astro emits with hash)
/_astro/*
  Cache-Control: public, max-age=31536000, immutable

# Static assets in public/ — long cache, but allow revalidation
/grain.png
  Cache-Control: public, max-age=31536000, immutable

/favicon.ico
  Cache-Control: public, max-age=2592000

/pulse.json
  Cache-Control: public, max-age=300, must-revalidate

# HTML caching and common security headers are normalized by worker/index.js.
# Keeping the catch-all out of this file prevents Cloudflare from joining two
# Cache-Control values when a fingerprinted asset matches multiple rules.
