---
import { SITE } from '@/lib/seo';
import { GROUPED_NAV_ROUTES } from '@/lib/routes';

type FooterItem = {
  href: string;
  label: string;
};

const footerGroups: { label: string; items: FooterItem[] }[] = GROUPED_NAV_ROUTES.map((group) => ({
  label: group.label,
  items: [
    ...group.routes
      .filter((route) => route.path !== '/')
      .map((route) => ({ href: route.path, label: route.label })),
    ...(group.label === 'Hiei' ? [
      { href: '/about#privacy', label: 'Privacy' },
    ] : []),
  ],
}));
---
<footer>
  <div class="ft-in">
    <div class="ft-map" aria-label="Footer sitemap">
      {footerGroups.map((group) => (
        <div class="ft-map-group">
          <div class="ft-map-label">{group.label}</div>
          <div class="ft-map-links">
            {group.items.map((item) => (
              <a href={item.href}>{item.label}</a>
            ))}
          </div>
        </div>
      ))}
    </div>
    <div class="ft-bottom">
      <span class="ft-copy">
        <span class="ft-seg">Since {SITE.foundedYear} · Powered by Hiei</span>
      </span>
    </div>
  </div>
</footer>
