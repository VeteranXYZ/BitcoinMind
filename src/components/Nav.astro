---
import { EXPLORE_NAV_ROUTES, GROUPED_NAV_ROUTES, PRIMARY_NAV_ROUTES, matchPaths } from '@/lib/routes';
import { SITE } from '@/lib/seo';

const path = Astro.url.pathname.replace(/\/$/, '') || '/';
const isActive = (m: string[]) => m.includes(path);
const exploreActive = EXPLORE_NAV_ROUTES.some((group) => group.routes.some((route) => isActive(matchPaths(route))));

/* flat counter for staggered animation delay */
let mmIdx = 0;
---
<nav>
  <div class="nav-in">
    <a class="nav-logo" href="/">Bitcoin<b>Mind</b></a>
    <div class="nav-links">
      {PRIMARY_NAV_ROUTES.map((route) => (
        <a class={`nl ${isActive(matchPaths(route)) ? 'on' : ''}`} href={route.path}>{route.label}</a>
      ))}
      <div class="nav-explore" data-explore-root>
        <button
          class={`nl nav-explore-btn ${exploreActive ? 'on' : ''}`}
          type="button"
          data-explore-button
          aria-haspopup="true"
          aria-expanded="false"
          aria-controls="explore-menu"
        >
          Explore
        </button>
        <div id="explore-menu" class="explore-menu" data-explore-menu hidden>
          {EXPLORE_NAV_ROUTES.map((group, groupIndex) => (
            <div class="explore-group" style={`--explore-col: ${groupIndex + 1}`}>
              <div class="explore-group-label">{group.label}</div>
              <div class="explore-group-list">
              {group.routes.map((route, itemIndex) => (
                  <a
                    class={`explore-item ${isActive(matchPaths(route)) ? 'explore-item--on' : ''}`}
                    href={route.path}
                    data-explore-item
                    style={`--explore-row-start: ${itemIndex * 2 + 2}`}
                  >
                    <span class="explore-item-title">{route.label}</span>
                    <span class="explore-item-desc">{route.description}</span>
                  </a>
                ))}
              </div>
            </div>
          ))}
        </div>
      </div>
    </div>
    <button
      class="nav-menu-btn"
      data-menu-open
      aria-label="Open menu"
      aria-controls="site-menu"
      aria-expanded="false"
    >Menu</button>
  </div>
</nav>

<div id="site-menu" class="mm" role="dialog" aria-modal="true" aria-label="Site menu" data-mobile-menu hidden>
  <div class="mm-panel" data-mobile-menu-panel>
    <nav class="mm-list" aria-label="Primary">
      {GROUPED_NAV_ROUTES.map((group, gi) => (
        <>
          {gi > 0 && <div class="mm-divider" />}
          <div class="mm-group-label">{group.label}</div>
          {group.routes.map((route) => {
            const delay = 0.04 + (mmIdx++) * 0.022;
            return (
              <a
                class={`mm-item ${isActive(matchPaths(route)) ? 'mm-item--on' : ''}`}
                href={route.path}
                data-menu-item
                style={`animation-delay: ${delay}s`}
              >
                {route.label}
              </a>
            );
          })}
        </>
      ))}
    </nav>
    <div class="mm-foot">
      <div class="mm-foot-rule"></div>
      <div class="mm-foot-l1">{SITE.host} · Since {SITE.foundedYear}</div>
    </div>
  </div>
</div>
