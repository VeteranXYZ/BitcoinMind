---
import Nav from '@/components/Nav.astro';
import Footer from '@/components/Footer.astro';
import AnalyticsHead from '@/components/AnalyticsHead.astro';
import { SITE, fullTitle, canonical } from '@/lib/seo';
import { LEGACY_HASH_REDIRECTS, PUBLIC_ROUTES } from '@/lib/routes';

// Critical fonts preloaded in <head> below. The first paint uses the same
// three-family system as the rest of the site: display, body/UI, and mono.
import literata700Normal from '@fontsource/literata/files/literata-latin-700-normal.woff2?url';
import inter400Normal from '@fontsource/inter/files/inter-latin-400-normal.woff2?url';
import geistMono400Normal from '@fontsource/geist-mono/files/geist-mono-latin-400-normal.woff2?url';

// Latin subset only — site is English. Keep weights deliberately narrow.
import '@fontsource/literata/latin-600.css';
import '@fontsource/literata/latin-700.css';
import '@fontsource/literata/latin-600-italic.css';
import '@fontsource/literata/latin-700-italic.css';
import '@fontsource/inter/latin-400.css';
import '@fontsource/inter/latin-500.css';
import '@fontsource/inter/latin-600.css';
import '@fontsource/inter/latin-700.css';
import '@fontsource/geist-mono/latin-400.css';
import '@fontsource/geist-mono/latin-500.css';

import '@/styles/design-system.css';
import '@/styles/styles.css';

interface Props {
  title: string;
  description: string;
  path: string;
  metaTitle?: string;
  ogTitle?: string;
  ogDescription?: string;
  twitterTitle?: string;
  twitterDescription?: string;
  socialImage?: string;
  socialImageAlt?: string;
  jsonLd?: Record<string, unknown> | Array<Record<string, unknown>>;
  ogType?: 'website' | 'article';
  robots?: string;
  showFooter?: boolean;
  dateModified?: string;
}

const {
  title,
  description,
  path,
  metaTitle,
  ogTitle,
  ogDescription,
  twitterTitle,
  twitterDescription,
  socialImage: socialImageOverride,
  socialImageAlt = 'BitcoinMind — a first-principles guide to Bitcoin',
  jsonLd,
  ogType = 'website',
  robots,
  showFooter = true,
  dateModified,
} = Astro.props;

const routeByPath = new Map(PUBLIC_ROUTES.map((route) => [route.path, route]));
const currentRoute = routeByPath.get(path);
const pageTitle = metaTitle ?? fullTitle(title);
const socialTitle = ogTitle ?? pageTitle;
const socialDescription = ogDescription ?? description;
const tweetTitle = twitterTitle ?? socialTitle;
const tweetDescription = twitterDescription ?? socialDescription;
const url = canonical(path);
const socialImage = socialImageOverride ?? SITE.socialImage;
const resolvedDateModified = dateModified ?? currentRoute?.lastModified ?? SITE.lastModified;
const robotsDirective = robots ?? 'index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1';
const suppliedLd = Array.isArray(jsonLd) ? jsonLd : jsonLd ? [jsonLd] : [];
const pageLd = {
  '@context': 'https://schema.org',
  '@type': 'WebPage',
  name: pageTitle,
  description,
  url,
  inLanguage: 'en',
  dateModified: resolvedDateModified,
  isPartOf: {
    '@type': 'WebSite',
    name: SITE.name,
    url: SITE.url,
  },
  author: { '@type': 'Person', name: SITE.author, url: canonical('/about') },
};
const breadcrumbRoutes: (typeof PUBLIC_ROUTES)[number][] = [];
let breadcrumbRoute = currentRoute;
while (breadcrumbRoute && breadcrumbRoute.path !== '/') {
  breadcrumbRoutes.unshift(breadcrumbRoute);
  breadcrumbRoute = breadcrumbRoute.parentPath ? routeByPath.get(breadcrumbRoute.parentPath) : undefined;
}
const breadcrumbItems = breadcrumbRoutes.length > 0
  ? breadcrumbRoutes.map((route) => ({ name: route.label, item: canonical(route.path) }))
  : [{ name: title, item: url }];
const breadcrumbLd = path === '/' ? null : {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: SITE.name, item: SITE.url },
    ...breadcrumbItems.map((item, index) => ({ '@type': 'ListItem', position: index + 2, ...item })),
  ],
};
const ldArray = [pageLd, ...(breadcrumbLd ? [breadcrumbLd] : []), ...suppliedLd];
const legacyHashRedirects = LEGACY_HASH_REDIRECTS;
---
<!DOCTYPE html>
<html lang="en" style={`--bg: ${SITE.themeColor}`}>
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>{pageTitle}</title>
  <meta name="description" content={description} />
  <meta name="author" content={SITE.author} />
  <meta name="theme-color" content={SITE.themeColor} />
  <meta name="robots" content={robotsDirective} />
  <link rel="canonical" href={url} />
  <link rel="sitemap" href="/sitemap.xml" />
  <link rel="icon" type="image/x-icon" href="/favicon.ico" />
  <AnalyticsHead />
  <script is:inline>document.documentElement.classList.add('js');</script>

  <link rel="preload" href={literata700Normal} as="font" type="font/woff2" crossorigin="anonymous" />
  <link rel="preload" href={inter400Normal} as="font" type="font/woff2" crossorigin="anonymous" />
  <link rel="preload" href={geistMono400Normal} as="font" type="font/woff2" crossorigin="anonymous" />

  <meta property="og:type" content={ogType} />
  <meta property="og:title" content={socialTitle} />
  <meta property="og:description" content={socialDescription} />
  <meta property="og:url" content={url} />
  <meta property="og:site_name" content={SITE.name} />
  <meta property="og:locale" content="en_US" />
  <meta property="og:image" content={socialImage} />
  <meta property="og:image:secure_url" content={socialImage} />
  <meta property="og:image:width" content="1200" />
  <meta property="og:image:height" content="630" />
  <meta property="og:image:alt" content={socialImageAlt} />
  {ogType === 'article' && <meta property="article:modified_time" content={resolvedDateModified} />}

  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:title" content={tweetTitle} />
  <meta name="twitter:description" content={tweetDescription} />
  <meta name="twitter:image" content={socialImage} />
  <meta name="twitter:image:alt" content={socialImageAlt} />

  <script is:inline define:vars={{ legacyHashRedirects }}>
    // Hash redirect — must run before render so old SPA hash links land on the right page.
    (function () {
      var t = legacyHashRedirects[location.hash];
      if (t && location.pathname === '/') {
        location.replace(t + location.search);
      }
    })();
  </script>

  {ldArray.map((ld) => (
    <script is:inline type="application/ld+json" set:html={JSON.stringify(ld)} />
  ))}
</head>
<body>
  <a class="skip-link" href="#main-content">Skip to content</a>
  <div id="pb"></div>
  <div class="grain" aria-hidden="true"></div>

  <Nav />

  <main id="main-content" tabindex="-1">
    <slot />
  </main>

  {showFooter && <Footer />}

  <script>
    import '@/scripts/reading-progress';
    import '@/scripts/mobile-menu';
    import '@/scripts/explore-menu';
  </script>
</body>
</html>

<style is:global>
  .grain {
    position: fixed;
    inset: 0;
    background-image: url('/grain.png');
    background-size: 256px;
    z-index: 9998;
    pointer-events: none;
    opacity: 0.028;
    mix-blend-mode: overlay;
  }
</style>
