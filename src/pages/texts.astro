---
import Base from '@/layouts/Base.astro';
import TextCard from '@/components/TextCard.astro';
import StudyLoop from '@/components/StudyLoop.astro';
import StudyNext from '@/components/StudyNext.astro';
import ResourceFilter from '@/components/ResourceFilter.astro';
import { TEXTS } from '@/data/texts';
import { filterValues, searchValues, textTypeLabel } from '@/lib/resources';

const TAGS = ['All', 'Primary', 'Security', 'Verification', 'Adoption', 'Sovereignty', 'Reference', 'Beginner', 'Intermediate', 'Advanced'];
const textFilterAliases = (item: typeof TEXTS[number]) => {
  const aliases: string[] = [];
  if (item.group === 'Primary Texts' || item.tags.includes('Whitepaper')) aliases.push('Primary');
  if (item.tags.some((tag) => ['Node', 'Verification', 'Technical'].includes(tag))) aliases.push('Verification');
  if (item.tags.some((tag) => ['Adoption', 'Institutional', 'History'].includes(tag))) aliases.push('Adoption');
  return aliases;
};
const textValues = (item: typeof TEXTS[number]) => filterValues([
  ...item.tags,
  ...textFilterAliases(item),
  item.difficulty,
  item.group,
  item.pathStage,
  textTypeLabel(item),
]);
const textSearch = (item: typeof TEXTS[number]) => searchValues([
  item.title,
  item.author,
  item.learningRole,
  item.shortDescription,
  item.layer,
  ...item.tags,
]);
const authorType = (author: string) =>
  author === 'Bitcoin.org' || author.toLowerCase().includes('contributors') ? 'Organization' : 'Person';

const itemList = {
  '@context': 'https://schema.org',
  '@type': 'ItemList',
  name: 'BitcoinMind Foundational Texts',
  itemListElement: TEXTS.map((item, i) => ({
    '@type': 'ListItem',
    position: i + 1,
    item: {
      '@type': 'CreativeWork',
      name: item.title,
      author: { '@type': authorType(item.author), name: item.author },
      ...(item.year > 0 ? { datePublished: String(item.year) } : {}),
      description: item.shortDescription,
      url: item.link,
    },
  })),
};
---
<Base
  title="Bitcoin Texts"
  metaTitle="Bitcoin Texts — Whitepaper, Essays, and Technical References"
  description="Foundational Bitcoin texts: the whitepaper, monetary history, protocol security, full-node verification, adoption arguments, and critical references."
  ogTitle="Foundational Bitcoin Texts — BitcoinMind"
  ogDescription="Primary sources and influential arguments, selected for study rather than treated as doctrine."
  path="/texts"
  jsonLd={itemList}
>
  <div class="page">
    <div class="c">
      <div class="ph">
        <div class="ph-eye">Texts</div>
        <h1 class="ph-title">Foundational <em>Texts</em></h1>
        <p class="ph-desc">Primary sources and influential arguments, selected for study rather than treated as doctrine.</p>
      </div>
      <StudyLoop compact />
      <ResourceFilter filters={TAGS} searchLabel="texts" emptyMessage="No texts match this filter.">
        <div class="grid-auto">
          {TEXTS.map((item) => (
            <div data-filter-card data-filter-values={textValues(item)} data-filter-search={textSearch(item)}>
              <TextCard item={item} />
            </div>
          ))}
        </div>
      </ResourceFilter>
      <StudyNext
        previous={{ href: '/library', label: 'Library', description: 'Return to the curated books and learning roles.' }}
        next={{ href: '/toolkit', label: 'Toolkit', description: 'Move from reading claims to observing and verifying systems.' }}
      />
    </div>
  </div>
</Base>
